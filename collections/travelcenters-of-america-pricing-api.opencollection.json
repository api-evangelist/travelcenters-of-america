{
  "opencollection": "1.0.0",
  "info": {
    "name": "TravelCenters of America Fuel Codes Pricing API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pricing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Pricing",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.accessta.com/v1/pricing",
            "params": [
              {
                "name": "location_id",
                "value": "",
                "type": "query",
                "description": "Filter by specific location"
              },
              {
                "name": "fuel_type",
                "value": "",
                "type": "query",
                "description": "Filter by fuel type"
              },
              {
                "name": "lat",
                "value": "",
                "type": "query"
              },
              {
                "name": "lon",
                "value": "",
                "type": "query"
              },
              {
                "name": "radius",
                "value": "",
                "type": "query",
                "description": "Search radius in miles"
              }
            ]
          },
          "docs": "Returns current fuel and service pricing at travel center locations. Provides diesel, gasoline, and DEF pricing by location."
        }
      ]
    }
  ],
  "bundled": true
}