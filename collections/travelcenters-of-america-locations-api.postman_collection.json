  "info": {
    "_postman_id": "b3391ef2-e7cd-42c9-bb02-36af4212ab17",
    "name": "TravelCenters of America Fuel Codes Locations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "TravelCenters of America provides REST APIs for integrating with TA and Petro travel center operations. Available services include truck service work order management, retail location data, fuel codes, pricing, parking availability, and shower availability across the largest publicly traded full-service travel center network in the United States.\n\nContact Support:\n Name: TravelCenters of America Developer Support",
      "type": "text/plain"
    }
  }
